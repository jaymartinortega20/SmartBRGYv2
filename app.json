{
  "expo": {
    "name": "SmartBRGY V2",
    "slug": "smartbrgy-v2",
    "version": "2.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/images/SmartBRGY.png",
    "scheme": "smartbrgyv2",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffae00"
      },
      "package": "com.jaymartinortega.smartbrgyv2",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/SmartBRGY.png",
          "color": "#2e7d32",
          "defaultChannel": "smartbrgy-updates"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffae00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
